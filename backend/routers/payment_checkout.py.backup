import logging
from typing import Optional

from fastapi import APIRouter, Depends, HTTPException
from pydantic import BaseModel
from sqlalchemy.ext.asyncio import AsyncSession

from core.config import settings
from core.database import get_db
from services.payment import PaymentService, CheckoutSessionRequest, CheckoutError
from services.donations import DonationsService
from services.projects import ProjectsService
from dependencies.auth import get_current_user
from schemas.auth import UserResponse

logger = logging.getLogger(__name__)

router = APIRouter(prefix="/api/v1/payment", tags=["payment"])


class CreateDonationCheckoutRequest(BaseModel):
    """Request to create a Stripe checkout session for a donation."""
    amount: int  # Amount in FCFA
    cause: str
    payment_method: str  # stripe, orange_money, wave
    project_id: Optional[int] = None
    donor_first_name: Optional[str] = None
    donor_last_name: Optional[str] = None
    donor_email: Optional[str] = None
    donor_phone: Optional[str] = None
    message: Optional[str] = None


class CreateDonationCheckoutResponse(BaseModel):
    """Response with checkout URL or mobile payment instructions."""
    checkout_url: Optional[str] = None
    session_id: Optional[str] = None
    donation_id: Optional[int] = None
    payment_method: str
    instructions: Optional[str] = None


class VerifyPaymentRequest(BaseModel):
    """Request to verify a Stripe payment."""
    session_id: str


class VerifyPaymentResponse(BaseModel):
    """Response with payment verification result."""
    status: str
    payment_status: str
    donation_id: Optional[int] = None
    amount: Optional[int] = None


@router.post("/create-checkout", response_model=CreateDonationCheckoutResponse)
async def create_donation_checkout(
    data: CreateDonationCheckoutRequest,
    current_user: UserResponse = Depends(get_current_user),
    db: AsyncSession = Depends(get_db),
):
    """Create a checkout session for a donation."""
    logger.info(f"Creating donation checkout: amount={data.amount}, method={data.payment_method}")

    if data.amount < 500:
        raise HTTPException(status_code=400, detail="Le montant minimum est de 500 FCFA")

    donations_service = DonationsService(db)

    if data.payment_method == "stripe":
        # Create Stripe checkout session
        payment_service = PaymentService()

        # Convert FCFA to EUR for Stripe (approximate: 1 EUR ≈ 656 FCFA)
        amount_eur = round(data.amount / 656, 2)
        if amount_eur < 0.50:
            amount_eur = 0.50

        try:
            frontend_url = settings.frontend_url if hasattr(settings, 'frontend_url') else "http://localhost:5173"

            checkout_request = CheckoutSessionRequest(
                amount=amount_eur,
                currency="eur",
                mode="payment",
                ui_mode="hosted",
                success_url=f"{frontend_url}/payment/success?session_id={{CHECKOUT_SESSION_ID}}",
                cancel_url=f"{frontend_url}/payment/cancel",
                metadata={
                    "cause": data.cause,
                    "amount_fcfa": str(data.amount),
                    "donor_email": data.donor_email or "",
                    "donor_name": f"{data.donor_first_name or ''} {data.donor_last_name or ''}".strip(),
                },
            )

            response = await payment_service.create_checkout_session(checkout_request)

            # Create donation record with pending status
            donation_data = {
                "amount": data.amount,
                "cause": data.cause,
                "payment_method": "stripe",
                "payment_status": "pending",
                "stripe_session_id": response.session_id,
                "project_id": data.project_id,
                "donor_first_name": data.donor_first_name,
                "donor_last_name": data.donor_last_name,
                "donor_email": data.donor_email,
                "donor_phone": data.donor_phone,
                "message": data.message,
            }

            donation = await donations_service.create(donation_data, user_id=str(current_user.id))

            return CreateDonationCheckoutResponse(
                checkout_url=response.url,
                session_id=response.session_id,
                donation_id=donation.id if donation else None,
                payment_method="stripe",
            )

        except CheckoutError as e:
            logger.error(f"Stripe checkout error: {str(e)}")
            raise HTTPException(status_code=500, detail=f"Erreur de paiement: {str(e)}")

    else:
        # For Orange Money / Wave - create donation record with instructions
        donation_data = {
            "amount": data.amount,
            "cause": data.cause,
            "payment_method": data.payment_method,
            "payment_status": "pending",
            "project_id": data.project_id,
            "donor_first_name": data.donor_first_name,
            "donor_last_name": data.donor_last_name,
            "donor_email": data.donor_email,
            "donor_phone": data.donor_phone,
            "message": data.message,
        }

        donation = await donations_service.create(donation_data, user_id=str(current_user.id))

        method_name = "Orange Money" if data.payment_method == "orange_money" else "Wave"
        instructions = (
            f"Pour compléter votre don de {data.amount:,} FCFA via {method_name}, "
            f"veuillez envoyer le montant au +221 77 939 43 44. "
            f"Référence: DON-{donation.id if donation else '000'}"
        )

        return CreateDonationCheckoutResponse(
            donation_id=donation.id if donation else None,
            payment_method=data.payment_method,
            instructions=instructions,
        )


@router.post("/verify", response_model=VerifyPaymentResponse)
async def verify_payment(
    data: VerifyPaymentRequest,
    current_user: UserResponse = Depends(get_current_user),
    db: AsyncSession = Depends(get_db),
):
    """Verify a Stripe payment and update donation status."""
    logger.info(f"Verifying payment for session: {data.session_id}")

    payment_service = PaymentService()
    donations_service = DonationsService(db)

    try:
        status = await payment_service.get_checkout_status(data.session_id)

        # Find and update the donation record
        donation = await donations_service.get_by_field("stripe_session_id", data.session_id)

        if donation:
            new_status = "paid" if status.payment_status == "paid" else "failed"
            await donations_service.update(
                donation.id,
                {"payment_status": new_status},
                user_id=str(current_user.id),
            )

            # If paid, update the project's raised amount and donor count
            if new_status == "paid" and donation.project_id:
                projects_service = ProjectsService(db)
                project = await projects_service.get_by_id(donation.project_id)
                if project:
                    await projects_service.update(
                        donation.project_id,
                        {
                            "raised": (project.raised or 0) + donation.amount,
                            "donors": (project.donors or 0) + 1,
                        },
                    )

            return VerifyPaymentResponse(
                status=status.status,
                payment_status=status.payment_status,
                donation_id=donation.id,
                amount=donation.amount,
            )

        return VerifyPaymentResponse(
            status=status.status,
            payment_status=status.payment_status,
        )

    except CheckoutError as e:
        logger.error(f"Payment verification error: {str(e)}")
        raise HTTPException(status_code=500, detail=f"Erreur de vérification: {str(e)}")
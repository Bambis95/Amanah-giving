# ==========================================================
# Amanah Giving - Configuration du backend (exemple)
# Copiez ce fichier vers ".env" puis adaptez les valeurs :
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (Linux / macOS)
# ==========================================================

# --- BASE DE DONNEES : PostgreSQL (recommandee et officielle du projet) ---
# Le backend se connecte a PostgreSQL des que DATABASE_URL est definie.

# Option 1 - Docker (la plus simple, developpement local) :
#   lancez "docker compose up -d" a la racine du projet (dossier app/),
#   puis decommentez la ligne ci-dessous :
DATABASE_URL=postgresql+asyncpg://amanah:amanah_secret@localhost:5432/amanah_giving

# Option 2 - PostgreSQL installe nativement sur Windows :
# DATABASE_URL=postgresql+asyncpg://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/amanah_giving

# Option 3 - PostgreSQL managed dans le cloud (production : Neon, Supabase, Railway) :
# DATABASE_URL=postgresql+asyncpg://utilisateur:motdepasse@hote:5432/nom_db?sslmode=require

# Note : sans DATABASE_URL, le backend retombe sur SQLite (fichier app.db).
# C'est reserve aux tests rapides sans base ; a eviter en production.

# --- Paiement Stripe (necessaire pour les dons par carte) ---
# Cle secrete Stripe : sk_test_... (test) ou sk_live_... (production)
# STRIPE_SECRET_KEY=<votre cle secrete Stripe, commencant par sk_test_ ou sk_live_>

# --- URL du frontend (utilisee pour les redirections Stripe) ---
# FRONTEND_URL=http://localhost:5173

# --- Emails de confirmation de don (SMTP, optionnel) ---
# Sans SMTP_HOST, aucun email n'est envoye (les dons fonctionnent quand meme).
# Exemples : Brevo  smtp-relay.brevo.com:587 | Gmail smtp.gmail.com:587 (mot de passe d'application)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=votre-identifiant
# SMTP_PASSWORD=votre-mot-de-passe
# SMTP_USE_SSL=false            # true pour le port 465
# EMAIL_FROM=dons@votre-domaine.org
# EMAIL_FROM_NAME=SENJAPO

# --- Compte administrateur (optionnel) ---
# ADMIN_USER_ID=
# ADMIN_USER_EMAIL=

# --- Mode "bientot disponible" (avant le lancement officiel) ---
# false : le site reste visible mais aucun nouveau don n'est accepte (redemarrer le backend apres modification).
# DONATIONS_ENABLED=false

# --- Sessions (optionnel) ---
# Deconnexion automatique apres inactivite (minutes) : administrateurs / autres comptes.
# Chaque action prolonge la session ; au-dela de SESSION_MAX_HOURS apres la connexion,
# il faut se reconnecter meme en restant actif.
# ADMIN_IDLE_MINUTES=15
# JWT_EXPIRE_MINUTES=60
# SESSION_MAX_HOURS=12

# --- Serveur (optionnel) ---
# PORT=8000
